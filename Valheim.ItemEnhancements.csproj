<Project Sdk="Microsoft.NET.Sdk">

  <!-- Import local user environment settings if exists (git ignored) -->
  <Import Project="$(ProjectDir)Environment.props" Condition="Exists('$(ProjectDir)Environment.props')" />
  <Import Project="$(MSBuildProjectFullPath).user" Condition="Exists('$(MSBuildProjectFullPath).user')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Valheim.ItemEnhancements</AssemblyName>
    <RootNamespace>Valheim.ItemEnhancements</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>10.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    
    <!-- Valheim Game & Modding Paths (defaults fallback if not defined in Environment.props) -->
    <ValheimPath Condition="'$(ValheimPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimPath>
    <ValheimManaged Condition="'$(ValheimManaged)' == ''">$(ValheimPath)\valheim_Data\Managed</ValheimManaged>

    <!-- Optional r2modman Profile Directory -->
    <R2ModmanProfileDir Condition="'$(R2ModmanProfileDir)' == ''"></R2ModmanProfileDir>

    <!-- BepInEx Core Path -->
    <BepInExCore Condition="'$(BepInExCore)' == '' and '$(R2ModmanProfileDir)' != ''">$(R2ModmanProfileDir)\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(ValheimPath)\BepInEx\core</BepInExCore>

    <!-- Plugin & Config Output Directories -->
    <R2ModmanPluginDir Condition="'$(R2ModmanPluginDir)' == '' and '$(R2ModmanProfileDir)' != ''">$(R2ModmanProfileDir)\BepInEx\plugins\$(AssemblyName)</R2ModmanPluginDir>
    <R2ModmanConfigDir Condition="'$(R2ModmanConfigDir)' == '' and '$(R2ModmanProfileDir)' != ''">$(R2ModmanProfileDir)\BepInEx\config</R2ModmanConfigDir>
    <SteamPluginDir Condition="'$(SteamPluginDir)' == ''">$(ValheimPath)\BepInEx\plugins\$(AssemblyName)</SteamPluginDir>
    <SteamConfigDir Condition="'$(SteamConfigDir)' == ''">$(ValheimPath)\BepInEx\config</SteamConfigDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game and Unity References -->
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimManaged)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManaged)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ValheimManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- BepInEx and Harmony References -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
  </ItemGroup>

  <!-- Auto-copy to both r2modman and Steam plugins and configs after build -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <PluginFiles Include="$(TargetDir)*.dll" />
      <PluginFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <ConfigFiles Include="$(ProjectDir)Configuration\*.cfg" />
      <YamlFiles Include="$(ProjectDir)Configuration\Yaml\*.yml;$(ProjectDir)Configuration\Yaml\*.txt" />
    </ItemGroup>

    <!-- Deploy to r2modman if configured and profile exists -->
    <MakeDir Directories="$(R2ModmanPluginDir)" Condition="'$(R2ModmanProfileDir)' != '' and Exists('$(R2ModmanProfileDir)')" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(R2ModmanPluginDir)" Condition="'$(R2ModmanProfileDir)' != '' and Exists('$(R2ModmanProfileDir)')" />
    <Copy SourceFiles="@(ConfigFiles)" DestinationFolder="$(R2ModmanConfigDir)" Condition="'$(R2ModmanProfileDir)' != '' and Exists('$(R2ModmanProfileDir)')" />
    <MakeDir Directories="$(R2ModmanConfigDir)\ckforgame.ItemEnhancements" Condition="'$(R2ModmanProfileDir)' != '' and Exists('$(R2ModmanProfileDir)')" />
    <Copy SourceFiles="@(YamlFiles)" DestinationFolder="$(R2ModmanConfigDir)\ckforgame.ItemEnhancements" Condition="'$(R2ModmanProfileDir)' != '' and Exists('$(R2ModmanProfileDir)')" />

    <!-- Deploy to Steam BepInEx if plugins folder exists -->
    <MakeDir Directories="$(SteamPluginDir)" Condition="Exists('$(ValheimPath)\BepInEx\plugins')" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(SteamPluginDir)" Condition="Exists('$(ValheimPath)\BepInEx\plugins')" />
    <Copy SourceFiles="@(ConfigFiles)" DestinationFolder="$(SteamConfigDir)" Condition="Exists('$(ValheimPath)\BepInEx\plugins')" />
    <MakeDir Directories="$(SteamConfigDir)\ckforgame.ItemEnhancements" Condition="Exists('$(ValheimPath)\BepInEx\plugins')" />
    <Copy SourceFiles="@(YamlFiles)" DestinationFolder="$(SteamConfigDir)\ckforgame.ItemEnhancements" Condition="Exists('$(ValheimPath)\BepInEx\plugins')" />
  </Target>

  <!-- Optional MSBuild target to create Thunderstore distribution package: dotnet build -c Release -p:PackageThunderstore=true -->
  <Target Name="PackageThunderstore" AfterTargets="PostBuild" Condition="'$(PackageThunderstore)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)export-dist.ps1&quot; -SkipBuild -Configuration $(Configuration)" />
  </Target>

</Project>